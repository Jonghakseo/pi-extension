{
	"name": "@ryan_nookpi/pi-extension-web-access",
	"version": "0.2.0",
	"description": "Web search, page/PDF/GitHub/YouTube content extraction tools for pi (fork of pi-web-access).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Jonghakseo/pi-extension.git",
		"directory": "packages/web-access"
	},
	"bugs": {
		"url": "https://github.com/Jonghakseo/pi-extension/issues"
	},
	"homepage": "https://github.com/Jonghakseo/pi-extension/tree/main/packages/web-access#readme",
	"type": "module",
	"keywords": [
		"pi-package",
		"web-search",
		"exa"
	],
	"files": [
		"*.ts",
		"!*.test.ts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"linkedom": "^0.16.11",
		"p-limit": "^6.2.0",
		"turndown": "^7.2.2",
		"unpdf": "^1.4.0"
	},
	"devDependencies": {
		"@types/turndown": "^5.0.6"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
